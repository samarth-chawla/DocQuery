# Required for generated answers. Uploads and retrieval-only searches work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Streamlit uses this URL to reach the FastAPI process.
DOCQUERY_API_URL=http://127.0.0.1:8000

# Higher values require a closer semantic match before Gemini is called.
DOCQUERY_MIN_SIMILARITY=0.30
